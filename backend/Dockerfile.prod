FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# pg_dump must match the server major version or `/settings/backup`
# refuses to run with "aborting because of server version mismatch".
# Pin to PGDG's `postgresql-client-18` so prod deployments stay in
# lockstep with the postgres 18.x they're expected to point at.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG GIT_REF=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV TESTJAM_VERSION_REF=${GIT_REF} \
    TESTJAM_VERSION_COMMIT=${GIT_COMMIT} \
    TESTJAM_BUILD_DATE=${BUILD_DATE}

COPY . .
RUN pip install "."

RUN mkdir -p /app/uploads/cases /app/uploads/results /app/uploads/executions

EXPOSE 8000

CMD ["sh", "-c", "\
: ${SECRET_KEY:?SECRET_KEY env var is required (generate with: openssl rand -hex 32)} && \
: ${DATABASE_URL:?DATABASE_URL env var is required} && \
alembic upgrade head && \
uvicorn testjam.main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=*"]